# ============================================
# Portfolio Website Environment Variables
# ============================================
# 
# IMPORTANT: 
# - This file contains sensitive information
# - Never commit this file to Git (already in .gitignore)
# - Change all default values before deploying to production
# - After updating values, rebuild the app: npm run build
#
# ============================================

# ============================================
# Admin Dashboard Authentication
# ============================================
# Default admin password for accessing /admin
# Change this immediately after setup!
# Default: ayoub100
VITE_DEFAULT_ADMIN_PASSWORD=ayoub100

# Owner unlock password for account recovery
# Used when admin account is locked after failed login attempts
# Change this immediately after setup!
# Default: owner_unlock_2024
VITE_OWNER_UNLOCK_PASSWORD=owner_unlock_2024

# ============================================
# EmailJS Configuration (Contact Form)
# ============================================
# Get these values from your EmailJS account:
# 1. Sign up at https://www.emailjs.com/
# 2. Create an Email Service (get Service ID)
# 3. Create an Email Template (get Template ID)
# 4. Get your Public Key from Account → General
#
# See CONTACT_FORM_SETUP.md for detailed instructions
#
# Note: These can also be configured via Admin Dashboard → Contact Info

# EmailJS Service ID
# Example: service_xxxxxxxxx
VITE_EMAILJS_SERVICE_ID=

# EmailJS Template ID
# Example: template_xxxxxxxxx
VITE_EMAILJS_TEMPLATE_ID=

# EmailJS Public Key
# Example: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_EMAILJS_PUBLIC_KEY=

# ============================================
# Contact Email (Optional)
# ============================================
# Recipient email for contact form submissions
# This is optional - you can also set it in Admin Dashboard → Contact Info
# If not set here, the email from Contact Info will be used
VITE_CONTACT_EMAIL=

# ============================================
# Setup Instructions
# ============================================
# 1. Fill in all required values above
# 2. For EmailJS setup, follow CONTACT_FORM_SETUP.md
# 3. Change admin passwords to secure values
# 4. Run: npm run build (to apply changes)
# 5. Restart dev server: npm run dev
#
# Note: Environment variables are embedded in the build bundle
# This is normal for Vite applications, but remember that
# client-side code is visible to users
#
# ============================================
